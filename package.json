{
  "name": "imi-russias-crimes",
  "version": "1.0.0",
  "private": true,
  "description": "IMI — Russia's crimes against journalists and media in Ukraine: public monitoring platform with admin panel and PNG export",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "db:backup": "tsx --conditions=react-server scripts/backup.ts",
    "db:restore": "tsx --conditions=react-server scripts/restore.ts",
    "admin:create": "tsx --conditions=react-server scripts/admin-create.ts",
    "icons:build": "node scripts/icons/build-icons.mjs",
    "qa:screenshots": "tsx scripts/qa-screenshots.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "build:static": "node scripts/build-static.mjs",
    "pages:export": "tsx --conditions=react-server scripts/pages-export.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.2.0",
    "fflate": "^0.8.3",
    "kysely": "^0.29.9",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/overpass": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "7.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "satori": {
      "fflate": "^0.8.3"
    }
  }
}
